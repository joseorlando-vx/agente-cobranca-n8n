# =============================================================
# Copy this file to .env and fill in real values.
# .env is already in .gitignore, never commit real values.
# See SECURITY.md and config/README.md for where each credential
# should actually be registered (most go in the n8n credential
# manager, not here).
# =============================================================

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=

# --- Google Sheets ---
SHEET_DOCUMENT_ID=
SHEET_TAB_NAME=

# --- Internal alert (D+7 escalation) ---
ALERTA_INTERNO_WHATSAPP=

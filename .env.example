# =============================================================
# Copie este arquivo para .env e preencha com valores reais.
# O .env já está no .gitignore, nunca commite valores reais.
# Ver SECURITY.md e config/README.md para onde cada credencial
# deve efetivamente ser cadastrada (a maioria vai no gerenciador
# de credenciais do n8n, não aqui).
# =============================================================

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=

# --- Google Sheets ---
SHEET_DOCUMENT_ID=
SHEET_TAB_NAME=

# --- Alerta interno (escalada D+7) ---
ALERTA_INTERNO_WHATSAPP=
